{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Fix is here: Add vite/client to this array */
    "types": ["node", "vite/client"], 

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Remaining options... */
    "allowJs": true,
    "moduleDetection": "force",
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["src"]
}